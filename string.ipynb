   "source": [
    "#reverse a string\n",
    "s='aabbbaabbcccs'\n",
    "s=list(s)\n",
    "n=len(s)\n",
    "start=0\n",
    "end=n-1\n",
    "while(start<end):\n",
    "    s[start],s[end]=s[end],s[start]\n",
    "    start+=1\n",
    "    end-=1\n",
    "s=''.join(s)\n",
    "print(s)"
   ]
